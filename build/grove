#!/usr/bin/env bash
# build/grove — cross-compile the grove CLI to linux/amd64 with a git-describe
# version stamp, package a self-contained installer, and (given a host) scp it
# over and install it. Modeled on netstar-labs/inbox/build/inbox.
#
#   build/grove [--cli|--server] [user@host]
#
# grove is a library + CLI, not a daemon, so both modes install the same binary
# to /usr/local/bin (there is no service). With no host the package is left under
# build/install/ for you to transmit yourself.

set -eu

# ---- mode (kept distinct from the host arg) ---------------------------------
case "${1:-}" in
    --cli | --server) shift ;;
esac

# ---- configuration ----------------------------------------------------------
BINARY=grove
APP=./app/grove
BIN=/usr/local/bin

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

BUILD=$ROOT/build
INSTALL=$BUILD/install
PACKAGE=$BINARY.tgz
HISTORY=$BINARY.version
INSTALLER=$BINARY.sh
rm -rf "$INSTALL"
mkdir -p "$INSTALL"

# target host: positional arg, else build/host if present
HOST=${1:-}
if [ -z "$HOST" ] && [ -e build/host ]; then
    HOST=$(cat build/host)
fi

# ---- version ----------------------------------------------------------------
VERSION=$(git describe --tags 2>/dev/null || echo dev)
REVISION=$(git rev-parse --short=12 HEAD 2>/dev/null || echo none)
LDFLAGS="-s -w -X main.version=$VERSION -X main.build=$REVISION"

echo "VERSION  $VERSION $REVISION"
echo "BUILD    $BINARY ($APP) -> linux/amd64"
date -u +%Y.%m.%d.%H.%M | tr '\n' ' ' >> "$INSTALL/$HISTORY"
echo "$VERSION $REVISION $BINARY" >> "$INSTALL/$HISTORY"
GOWORK=off GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "$LDFLAGS" -o "$INSTALL/$BINARY" "$APP"

# ---- installer (runs on the target) -----------------------------------------
echo "BUILD    $INSTALLER"
{
cat << EOF_HEAD
#!/bin/sh
# generated by build/grove — installs the $BINARY CLI
set -eu
INSTALL=install
PACKAGE=$PACKAGE
HISTORY=$HISTORY
BINARY=$BINARY
BIN=$BIN
EOF_HEAD
cat << 'EOF_BODY'

[ "$(id -u)" = 0 ] || { echo "installer: run as root (sudo ./$BINARY.sh)"; exit 1; }
echo "install: unpack package"
rm -rf "$INSTALL"
tar -xzf "$PACKAGE"

mkdir -p "$BIN/version"
mv "$INSTALL/$HISTORY" "$BIN/version/"
cp "$INSTALL/$BINARY" "$BIN/"
echo "install: $BINARY -> $BIN/$BINARY"

rm -rf "$INSTALL" "$PACKAGE" "$BINARY.sh"
echo "install: complete"
EOF_BODY
} > "$INSTALL/$INSTALLER"
chmod a+x "$INSTALL/$INSTALLER"

# ---- package ----------------------------------------------------------------
echo "BUILD    $PACKAGE"
tar -czf "$BUILD/$PACKAGE" -C "$BUILD" install
mv "$BUILD/$PACKAGE" "$INSTALL/$PACKAGE"

# ---- transmit ---------------------------------------------------------------
if [ -n "$HOST" ]; then
    echo "TRANSMIT $PACKAGE + $INSTALLER -> $HOST"
    scp "$INSTALL/$PACKAGE" "$INSTALL/$INSTALLER" "$HOST:"
    echo "RUN      $HOST: sudo ./$INSTALLER"
    ssh "$HOST" "sudo ./$INSTALLER"
    echo "CLEANUP  $INSTALL"
    rm -rf "$INSTALL"
else
    echo "PACKAGE  $INSTALL/$PACKAGE"
    echo "         (no host given — scp this package + $INSTALLER to a server and run sudo ./$INSTALLER)"
fi
echo "bye"
